    {
      "name": "Validation & Rejection Tests",
      "description": "Tests asserting explicit structured JSON error payloads.\n\n### Collection Runner Config\n- **Iterations**: 5\n- **Delay**: 200ms\n- **Note**: This mimics bulk simulation loads.",
      "item": [
        {
          "name": "Upload Oversized File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 400\", () => { pm.response.to.have.status(400); });",
                  "pm.test(\"error flag is true\", () => { pm.expect(pm.response.json().error).to.be.true; });",
                  "pm.test(\"code is FILE_TOO_LARGE\", () => { pm.expect(pm.response.json().code).to.eql(\"FILE_TOO_LARGE\"); });",
                  "pm.test(\"message is a non-empty string\", () => { pm.expect(pm.response.json().message).to.be.a(\"string\").and.not.empty; });",
                  "pm.test(\"detail.max_size_mb is 50\", () => { pm.expect(pm.response.json().detail.max_size_mb).to.eql(50); });",
                  "pm.test(\"detail.received_size_mb > 50\", () => { pm.expect(pm.response.json().detail.received_size_mb).to.be.above(50); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "large_51mb.csv"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "upload"
              ]
            }
          }
